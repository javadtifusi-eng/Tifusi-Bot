+/* Ephemeral visibility only: no message text, credentials, or disk persistence. */
+(() => {
+  const id = crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2);
+  function report(closing = false) {
+    const init = window.Telegram?.WebApp?.initData;
+    if (!init) return;
+    fetch('/claudex/api/presence', {method:'POST', keepalive:true,
+      headers:{'Content-Type':'application/json','X-Init-Data':init},
+      body:JSON.stringify({id,visible:!closing && document.visibilityState==='visible'})
+    }).catch(() => {});
+  }
+  document.addEventListener('visibilitychange', () => report());
+  window.addEventListener('pagehide', () => report(true));
+  window.addEventListener('pageshow', () => report());
+  setInterval(() => { if (document.visibilityState==='visible') report(); }, 10000);
+  report();
+})();
