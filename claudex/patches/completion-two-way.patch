+"""Owner-authorized completion calls, only while the mini-app is absent."""
+import asyncio
+import json
+import time
+
+PRESENCE = {}
+SEEN = set()
+TASKS = set()
+LAST_CALL = 0.0
+RUNNING = False
+
+
+def visible():
+    now = time.monotonic()
+    for key in list(PRESENCE):
+        if now - PRESENCE[key] > 25:
+            del PRESENCE[key]
+    return bool(PRESENCE)
+
+
+async def presence(request):
+    from aiohttp import web
+    data = await request.json()
+    key = str(data.get('id', ''))[:80]
+    if not key:
+        raise web.HTTPBadRequest()
+    if data.get('visible') is True:
+        PRESENCE[key] = time.monotonic()
+    else:
+        PRESENCE.pop(key, None)
+    return web.json_response({'ok': True})
+
+
+def schedule(server, engine, key, title, summary):
+    ident = (engine, str(key))
+    if ident in SEEN:
+        return
+    SEEN.add(ident)
+    if len(SEEN) > 2000:
+        SEEN.clear()
+        SEEN.add(ident)
+    task = asyncio.create_task(deliver(server, engine, title, summary))
+    TASKS.add(task)
+    task.add_done_callback(TASKS.discard)
+
+
+async def deliver(server, engine, title, summary):
+    global LAST_CALL, RUNNING
+    # A closed/suspended WebView may leave a short-lived presence heartbeat.
+    await asyncio.sleep(35)
+    prefs = server.load(engine)
+    if (visible() or not prefs.get('notifications_enabled', True)
+            or not prefs.get('notify_completion', True) or not prefs.get('notify_call', True)):
+        return
+    if RUNNING or time.monotonic() - LAST_CALL < 60:
+        return
+    if any(job and job.get('status') == 'running' for job in server.JOBS.values()):
+        return
+    import claude_live
+    if claude_live.busy():
+        return
+    RUNNING = True
+    LAST_CALL = time.monotonic()
+    proc = None
+    try:
+        payload = json.dumps({'engine': engine, 'title': str(title)[:300],
+                              'summary': str(summary)[:5000]}, ensure_ascii=False).encode()
+        proc = await asyncio.create_subprocess_exec(
+            '/root/tgcall/venv/bin/python', '-I', '/root/tgcall/talk_call.py',
+            '--approved-call', '--completion-context', cwd='/root/tgcall',
+            stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.DEVNULL,
+            stderr=asyncio.subprocess.DEVNULL)
+        await asyncio.wait_for(proc.communicate(payload), 700)
+        server.log.info('completion call ended engine=%s exit=%s', engine, proc.returncode)
+    except Exception as exc:
+        server.log.warning('completion call failed engine=%s error=%s', engine, type(exc).__name__)
+    finally:
+        if proc and proc.returncode is None:
+            proc.terminate()
+            try:
+                await asyncio.wait_for(proc.wait(), 10)
+            except asyncio.TimeoutError:
+                proc.kill()
+                await proc.wait()
+        RUNNING = False
