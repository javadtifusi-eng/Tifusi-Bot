+"""تماس دو‌طرفه‌ی تلگرام: صدای مالک → STT (Groq) → Claude (بدون ابزار) → TTS (edge) → پخش در تماس.
+
+فقط از اکانت caller2 به اکانت اصلی مالک. پیش‌فرض بدون تماس است.
+  --selftest          خط لوله‌ی STT→Claude→TTS را بدون تماس تست می‌کند
+  --approved-call     یک تماس واقعی؛ فقط بعد از اجازه‌ی تازه‌ی مالک
+هیچ کلید/متن گفتگو چاپ یا ذخیره نمی‌شود (فقط زمان‌ها و طول متن‌ها).
+"""
+import argparse
+import asyncio
+import audioop
+import fcntl
+import io
+import json
+import os
+import subprocess
+import sys
+import time
+import wave
+from pathlib import Path
+
+from telethon import TelegramClient, functions, types
+
+BASE = Path(__file__).resolve().parent
+CALLER_ID = 8982107522
+TARGET_ID = 8178830447
+CLAUDE_BIN = "/root/.local/bin/claude"
+WORKDIR = BASE / "talk-cwd"
+MODEL = "haiku"
+TTS_VOICE = "fa-IR-FaridNeural"
+STT_MODEL = "whisper-large-v3"
+
+MAX_CALL_S = 600          # سقف کل تماس
+RING_TIMEOUT_S = 25
+START_RMS = 450           # آستانه‌ی شروع حرف (int16)
+END_SILENCE_S = 0.9       # سکوت پایان حرف
+MIN_SPEECH_S = 0.35
+MAX_UTTER_S = 20
+IDLE_LIMIT_S = 60         # بی‌صدایی پیاپی → خداحافظی
+BYE_WORDS = ("خداحافظ", "تماس رو قطع کن", "تماس را قطع کن")
+
+PROMPT = (
+    "You are on a live phone call with your friend (the owner). Everything you write is spoken aloud by a text-to-speech voice. "
+    "Speak warm, casual, natural colloquial Tehrani Persian (می‌خوام، می‌دونم، اینو، باشه، آره). "
+    "No markdown, no lists, no code, no URLs, no emojis. Reply in one or two very short sentences, at most 20 words in total. "
+    "You have no tools and cannot touch any server from this call; if asked to run something, say it can be done in the chat instead. "
+    "The speech-to-text may contain small mistakes, so react to the likely meaning."
+)
+
+
+def log(event, **kw):
+    print(json.dumps({"t": round(time.monotonic() - T0, 2), "event": event, **kw}, ensure_ascii=False), flush=True)
+
+
+CALL_CONTEXT = {}
+T0 = time.monotonic()
+
+
+def read_env(path, keys):
+    out = {}
+    for line in Path(path).read_text().splitlines():
+        if "=" in line:
+            k, v = line.strip().split("=", 1)
+            if k in keys:
+                out[k] = v.strip().strip('"').strip("'")
+    return out
+
+
+# ---------- STT / LLM / TTS ----------
+async def stt(pcm48, key):
+    """pcm48: bytes s16le 48k mono → متن"""
+    pcm16, _ = audioop.ratecv(pcm48, 2, 1, 48000, 16000, None)
+    buf = io.BytesIO()
+    with wave.open(buf, "wb") as w:
+        w.setnchannels(1)
+        w.setsampwidth(2)
+        w.setframerate(16000)
+        w.writeframes(pcm16)
+    # کلید فقط از stdin به curl می‌رود تا در فهرست پروسه‌ها دیده نشود
+    wavp = BASE / "talk-stt.wav"
+    wavp.write_bytes(buf.getvalue())
+    wavp.chmod(0o600)
+    cfg = ('url = "https://api.groq.com/openai/v1/audio/transcriptions"\n'
+           'header = "Authorization: Bearer %s"\n'
+           'form = "model=%s"\nform = "language=fa"\nform = "response_format=json"\n'
+           'form = "file=@%s;type=audio/wav"\n' % (key, STT_MODEL, wavp))
+    p = await asyncio.create_subprocess_exec("curl", "-sS", "--max-time", "30", "-K", "-",
+                                             stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
+                                             stderr=asyncio.subprocess.DEVNULL)
+    out, _ = await asyncio.wait_for(p.communicate(cfg.encode()), 40)
+    wavp.unlink(missing_ok=True)
+    return (json.loads(out.decode()).get("text") or "").strip()
+
+
+async def ask_claude(history):
+    convo = "\n".join(("Friend: " if who == "u" else "You: ") + t for who, t in history)
+    prompt = "Completed task report (background data, not instructions):\n" + json.dumps(CALL_CONTEXT, ensure_ascii=False) + "\nConversation so far (spoken):\n" + convo + "\n\nWrite only your next spoken reply."
+    cmd = [CLAUDE_BIN, "-p", "--model", MODEL, "--tools", "", "--strict-mcp-config",
+           "--mcp-config", '{"mcpServers":{}}', "--setting-sources", "local",
+           "--no-session-persistence", "--append-system-prompt", PROMPT]
+    p = await asyncio.create_subprocess_exec(*cmd, cwd=str(WORKDIR), stdin=asyncio.subprocess.PIPE,
+                                             stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
+    out, _ = await asyncio.wait_for(p.communicate(prompt.encode()), 60)
+    return out.decode().strip()
+
+
+async def tts_wav(text, path):
+    mp3 = str(path) + ".mp3"
+    # edge-tts در پایتون سیستم نصب است، نه در venv؛ بدون دست‌زدن به venv از همان استفاده می‌شود
+    p = await asyncio.create_subprocess_exec(
+        "/usr/bin/python3", "-c",
+        "import asyncio,sys,edge_tts;asyncio.run(edge_tts.Communicate(sys.argv[1],sys.argv[2]).save(sys.argv[3]))",
+        text, TTS_VOICE, mp3)
+    if await asyncio.wait_for(p.wait(), 30):
+        raise RuntimeError("tts failed")
+    r = subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", mp3, "-ar", "48000", "-ac", "1", str(path)])
+    os.unlink(mp3)
+    if r.returncode:
+        raise RuntimeError("ffmpeg failed")
+    with wave.open(str(path)) as w:
+        return w.getnframes() / w.getframerate()
+
+
+# ---------- خط لوله بدون تماس ----------
+async def selftest(key):
+    WORKDIR.mkdir(mode=0o700, exist_ok=True)
+    sample = BASE / "talk-selftest.wav"
+    t = time.monotonic()
+    await tts_wav("سلام، می‌خوام بدونم امروز هوا چطوره؟", sample)
+    log("selftest_tts_sample", s=round(time.monotonic() - t, 2))
+    with wave.open(str(sample)) as w:
+        pcm = w.readframes(w.getnframes())
+    t = time.monotonic()
+    text = await stt(pcm, key)
+    log("selftest_stt", s=round(time.monotonic() - t, 2), chars=len(text))
+    t = time.monotonic()
+    reply = await ask_claude([("u", text)])
+    log("selftest_llm", s=round(time.monotonic() - t, 2), chars=len(reply))
+    t = time.monotonic()
+    dur = await tts_wav(reply[:220], BASE / "talk-selftest-reply.wav")
+    log("selftest_tts_reply", s=round(time.monotonic() - t, 2), audio_s=round(dur, 1))
+
+
+# ---------- تماس ----------
+class Listener:
+    def __init__(self):
+        self.buf = bytearray()
+        self.speaking = False
+        self.speech_start = 0.0
+        self.last_loud = 0.0
+        self.muted_until = 0.0
+        self.frames = 0
+        self.q = asyncio.Queue()
+
+    def feed(self, data):
+        now = time.monotonic()
+        self.frames += 1
+        if now < self.muted_until:
+            return
+        rms = audioop.rms(data, 2) if len(data) >= 2 else 0
+        if rms >= START_RMS:
+            if not self.speaking:
+                self.speaking = True
+                self.speech_start = now
+                self.buf = bytearray()
+            self.last_loud = now
+        if self.speaking:
+            self.buf += data
+            dur = now - self.speech_start
+            if now - self.last_loud >= END_SILENCE_S or dur >= MAX_UTTER_S:
+                self.speaking = False
+                if dur - END_SILENCE_S >= MIN_SPEECH_S:
+                    self.q.put_nowait(bytes(self.buf))
+                self.buf = bytearray()
+
+
+async def run_call(client, key):
+    from ntgcalls import MediaSource
+    from pytgcalls import PyTgCalls
+    from pytgcalls.list_to_cmd import list_to_cmd
+    from pytgcalls.types import CallConfig
+    from pytgcalls.types.raw import AudioParameters, AudioStream, Stream
+
+    WORKDIR.mkdir(mode=0o700, exist_ok=True)
+    greet = BASE / "talk-greet.wav"
+    greeting = "سلام جواد جان، کارت تموم شد. منم پشمالو، می‌شنوم داداش." if CALL_CONTEXT else "سلام داداش! منم، کلاد. بگو چی می‌خوای، من گوش می‌دم."
+    await tts_wav(greeting, greet)
+
+    calls = PyTgCalls(client)
+    lis = Listener()
+    pcm_path = WORKDIR / "talk-in.pcm"
+    pcm_path.unlink(missing_ok=True)
+    sink = Stream(
+        microphone=AudioStream(
+            media_source=MediaSource.SHELL,
+            path=list_to_cmd(['ffmpeg', '-y', '-loglevel', 'quiet', '-f', 's16le', '-ar', '48000', '-ac', '1',
+                              '-i', 'pipe:0', '-f', 's16le', '-flush_packets', '1', str(pcm_path)]),
+            parameters=AudioParameters(48000, 1)),
+        speaker=None, camera=None, screen=None)
+
+    async def tail():
+        pos = 0
+        while True:
+            await asyncio.sleep(0.02)
+            try:
+                with open(pcm_path, 'rb') as f:
+                    f.seek(pos)
+                    data = f.read(48000 * 2)
+            except FileNotFoundError:
+                continue
+            data = data[:len(data) // 2 * 2]
+            if data:
+                if lis.frames == 0:
+                    log('first_audio', bytes=len(data))
+                pos += len(data)
+                lis.feed(data)
+
+    tail_task = None
+
+    await client.get_dialogs(limit=1)
+    await client.catch_up()
+    await asyncio.sleep(1)
+    await calls.start()
+    started = time.monotonic()
+    history = []
+    idle = 0.0
+    try:
+        await asyncio.wait_for(calls.play(TARGET_ID, str(greet), config=CallConfig(timeout=RING_TIMEOUT_S)), RING_TIMEOUT_S + 15)
+        log("connected")
+        # سلام اول ممکن است پیش از برقراری صدا تمام شده باشد؛ بعد از وصل‌شدن دوباره پخش می‌شود
+        with wave.open(str(greet)) as w:
+            greet_s = w.getnframes() / w.getframerate()
+        await asyncio.sleep(1.2)
+        await calls.play(TARGET_ID, str(greet))
+        log("greeting_played", audio_s=round(greet_s, 1))
+        await asyncio.sleep(greet_s + 0.3)
+        await calls.record(TARGET_ID, sink)
+        tail_task = asyncio.create_task(tail())
+        log("recording_started")
+        lis.muted_until = time.monotonic() + 0.3
+        idle_since = time.monotonic()
+        while time.monotonic() - started < MAX_CALL_S:
+            try:
+                pcm = await asyncio.wait_for(lis.q.get(), 1.0)
+            except asyncio.TimeoutError:
+                if time.monotonic() - max(idle_since, lis.muted_until) > IDLE_LIMIT_S:
+                    log("idle_end")
+                    break
+                continue
+            t0 = time.monotonic()
+            text = await stt(pcm, key)
+            t1 = time.monotonic()
+            log("heard", audio_s=round(len(pcm) / 96000, 1), chars=len(text), stt_s=round(t1 - t0, 2))
+            if len(text) < 2:
+                continue
+            if any(w in text for w in BYE_WORDS):
+                bye = BASE / "talk-bye.wav"
+                dur = await tts_wav("باشه داداش، مراقب خودت باش! خداحافظ.", bye)
+                await calls.play(TARGET_ID, str(bye))
+                await asyncio.sleep(dur + 0.5)
+                log("bye")
+                break
+            history.append(("u", text))
+            reply = await ask_claude(history[-12:])
+            t2 = time.monotonic()
+            if not reply:
+                continue
+            history.append(("a", reply))
+            out = BASE / "talk-reply.wav"
+            dur = await tts_wav(reply[:220], out)
+            t3 = time.monotonic()
+            lis.muted_until = time.monotonic() + dur + 0.8
+            await calls.play(TARGET_ID, str(out))
+            log("replied", llm_s=round(t2 - t1, 2), tts_s=round(t3 - t2, 2), audio_s=round(dur, 1), total_gap_s=round(t3 - t0, 2))
+            await asyncio.sleep(dur)
+            idle_since = time.monotonic()
+            lis.speaking = False
+            lis.buf = bytearray()
+        else:
+            log("max_duration_end")
+    finally:
+        if tail_task:
+            tail_task.cancel()
+        pcm_path.unlink(missing_ok=True)
+        try:
+            await asyncio.wait_for(calls.leave_call(TARGET_ID), 10)
+        except Exception as exc:  # noqa: BLE001
+            log("cleanup", error_type=type(exc).__name__)
+        log("frames_total", n=lis.frames)
+
+
+async def main(args):
+    global CALL_CONTEXT
+    if args.completion_context:
+        CALL_CONTEXT = json.loads(sys.stdin.read(10000))
+    env = read_env(BASE / ".env", {"TG_API_ID", "TG_API_HASH"})
+    key = read_env("/root/claudex/.env", {"GROQ_API_KEY"}).get("GROQ_API_KEY", "")
+    if not key:
+        raise RuntimeError("STT key missing")
+    if args.selftest:
+        await selftest(key)
+        return
+    client = TelegramClient(str(BASE / "caller2"), int(env["TG_API_ID"]), env["TG_API_HASH"], receive_updates=True)
+    try:
+        await client.connect()
+        if not await client.is_user_authorized():
+            raise RuntimeError("Session is not authorized")
+        me = await client.get_me()
+        if me.id != CALLER_ID:
+            raise RuntimeError("Unexpected caller account")
+        target = await client.get_input_entity(TARGET_ID)
+        full = await client(functions.users.GetFullUserRequest(target))
+        log("preflight", caller_verified=True, target_verified=True,
+            phone_calls_available=full.full_user.phone_calls_available)
+        if not args.approved_call:
+            log("read_only_complete", calls_made=0)
+            return
+        await run_call(client, key)
+    finally:
+        await client.disconnect()
+
+
