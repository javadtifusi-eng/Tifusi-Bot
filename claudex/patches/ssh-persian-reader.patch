+/* Readable Persian view of the terminal buffer; never transforms PTY input. */
+window.setupSshReader = function (term) {
+  const host = document.querySelector('#term');
+  const wrap = host.closest('.term-wrap');
+  const tools = wrap.querySelector('.term-tools');
+  const button = document.createElement('button');
+  button.type = 'button'; button.className = 'term-reader-toggle';
+  button.textContent = 'فارسی'; button.title = 'نمایش خوانای فارسی';
+  button.setAttribute('aria-controls', 'sshReader');
+  const reader = document.createElement('div');
+  reader.id = 'sshReader'; reader.className = 'ssh-reader';
+  reader.setAttribute('aria-label', 'خروجی خوانای ترمینال');
+  const stage = document.createElement('div'); stage.className = 'ssh-terminal-stage';
+  host.before(stage); stage.append(host, reader); tools.prepend(button);
+  let enabled = true, frame = 0, last = '';
+  try { enabled = localStorage.getItem('ssh-persian-reader') !== 'off'; } catch (_) {}
+  function render() {
+    frame = 0;
+    const active = enabled && term.buffer.active.type !== 'alternate';
+    stage.classList.toggle('persian-reading', active);
+    reader.hidden = !active;
+    button.setAttribute('aria-pressed', String(enabled));
+    button.classList.toggle('on', enabled);
+    if (!active) return;
+    const buf = term.buffer.active;
+    let lines = [];
+    const start = Math.max(0, buf.length - 800);
+    for (let i = start; i < buf.length; i++) {
+      const line = buf.getLine(i);
+      if (!line) continue;
+      const text = line.translateToString(!buf.getLine(i + 1)?.isWrapped);
+      if (line.isWrapped && lines.length) lines[lines.length - 1] += text;
+      else lines.push(text);
+    }
+    while (lines.length && !lines[lines.length - 1]) lines.pop();
+    const signature = lines.join('\n');
+    if (signature === last) return;
+    const atBottom = reader.scrollHeight - reader.scrollTop - reader.clientHeight < 55;
+    const scrollTop = reader.scrollTop;
+    const fragment = document.createDocumentFragment();
+    for (const text of lines) {
+      const row = document.createElement('div'); row.className = 'ssh-reader-line';
+      row.dir = 'auto'; row.textContent = text || '\u00a0';
+      if (/[\u0600-\u06ff\u0750-\u077f]/u.test(text)) row.classList.add('has-persian');
+      fragment.append(row);
+    }
+    reader.replaceChildren(fragment); last = signature;
+    reader.scrollTop = atBottom ? reader.scrollHeight : scrollTop;
+  }
+  function schedule() { if (!frame) frame = requestAnimationFrame(render); }
+  button.addEventListener('pointerdown', e => e.preventDefault());
+  button.addEventListener('click', () => {
+    enabled = !enabled;
+    try { localStorage.setItem('ssh-persian-reader', enabled ? 'on' : 'off'); } catch (_) {}
+    render();
+  });
+  term.onWriteParsed(schedule); term.onResize(schedule);
+  term.buffer.onBufferChange(schedule);
+  new ResizeObserver(schedule).observe(stage);
+  render();
+};
